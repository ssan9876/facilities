PORT=3000
APP_URL=http://localhost:3000
ORG_NAME=My Organization
ORG_TIMEZONE=America/Phoenix
# For local development only. Docker production requires oidc.
AUTH_MODE=demo
SESSION_SECRET=replace-with-at-least-32-random-characters
SEED_DEMO=true
# DATABASE_URL=postgres://facilities:password@localhost:5432/facilities
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Space separated IdP groups whose members may enter this single organization.
OIDC_ALLOWED_GROUPS=
OIDC_ADMIN_GROUP=facilities-admins
OIDC_MANAGER_GROUP=facilities-managers
OIDC_TECHNICIAN_GROUP=facilities-technicians
# Optional exact subject claim for initial administrator (never an email match).
OIDC_ADMIN_SUBJECT=
# Public GitHub repository used for admin release checks.
RELEASE_REPOSITORY=ssan9876/go-fmx-clone
# Installation location/access mode: lan, cloud, or tunnel. See deployment/HOSTING.md.
HOSTING_MODE=lan
# Microsoft Entra ID: look up group memberships through Microsoft Graph when a user is in
# too many groups for the token (group overage). Set to graph to enable; needs delegated User.Read.
OIDC_GROUPS_OVERAGE=
# Email notifications (optional). Use SMTP_URL (smtp:// or smtps://) or the separate fields.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Largest attachment in megabytes (photos, PDFs, documents). Keep the proxy body limit above this.
ATTACHMENT_MAX_MB=10
# Bearer token for GET /metrics (Prometheus text). Metrics are disabled when empty.
METRICS_TOKEN=
# debug, info, warn, error or silent. Logs are one JSON object per line.
LOG_LEVEL=info
# Requests per minute. Sign-in and provisioning are per client address; writes and uploads per account.
RATE_LIMIT_AUTH=30
RATE_LIMIT_WRITES=300
RATE_LIMIT_UPLOADS=30
RATE_LIMIT_PROVISIONING=600
# Nightly backups (run by the host agent: sudo facilities-update --install-agent).
# Days to keep nightly backups, a systemd OnCalendar schedule, and an optional rsync target
# (user@host:/path, reached with root's SSH key) for a copy off the server.
BACKUP_KEEP_DAYS=14
BACKUP_SCHEDULE=*-*-* 02:30:00
BACKUP_COPY_TO=
